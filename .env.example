# ── Supabase (Fase 0) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio — SOLO en el servidor, nunca en el cliente
SUPABASE_SERVICE_ROLE_KEY=

# ── Motor de triangulación (Fase 3) ───────────────────────────────
# Claude API: análisis y cruce del corpus (NO genera embeddings)
ANTHROPIC_API_KEY=

# Proveedor de embeddings (pieza aparte del stack).
# Voyage AI es el recomendado por Anthropic; OpenAI como alternativa.
VOYAGE_API_KEY=
# OPENAI_API_KEY=

# ── KYC / listas restrictivas (Fase 2) ────────────────────────────
# Proveedor por confirmar: Verdata / TusDatos.co (decisión abierta)
KYC_PROVEEDOR=pendiente
KYC_API_URL=
KYC_API_KEY=
